<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Talani Studio — Visual Layout Builder, Folder Uploader &amp; Operations</title>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Raleway:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{--ink:#304b54;--stone:#968d80;--paper:#f8f7f3;--line:#dcded9;--mist:#e9eeec}
    *{box-sizing:border-box}
    body{margin:0;width:100%;font-family:Raleway,sans-serif;color:var(--ink);background:var(--paper)}
    .display{font-family:Fraunces,serif}
    .eyebrow{letter-spacing:.23em;text-transform:uppercase}
    :is(a,button,input,select,textarea):focus-visible{outline:3px solid #ad8970;outline-offset:3px}
    .sticky-header{position:sticky;top:0;z-index:30;background:rgba(248,247,243,.97);backdrop-filter:blur(14px)}
    .header-top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
    .header-brand{display:flex;align-items:center;gap:12px;min-width:0}
    .header-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .subnav-strip{display:flex;gap:10px;overflow-x:auto;scrollbar-width:none;padding:10px 0}
    .subnav-strip::-webkit-scrollbar,.tab-row::-webkit-scrollbar{display:none}
    .subnav-link{flex:none;font-size:12px;font-weight:700;color:var(--ink);text-decoration:none;padding:8px 14px;border:1px solid var(--line);background:white;white-space:nowrap}
    .subnav-link:hover{border-color:var(--ink);background:var(--mist)}
    .tab-row{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:4px 0 18px}
    .studio-tab{flex:none;border:1px solid #bfc9c5;border-radius:99px;background:white;color:var(--ink);padding:10px 16px;font-size:12px;font-weight:700;cursor:pointer}
    .studio-tab[aria-selected=true]{background:var(--ink);color:white;border-color:var(--ink)}
    .canvas-block{background:white;border:1px solid var(--line);padding:18px;transition:border-color .15s}
    .canvas-block.selected{border:2px solid var(--ink);box-shadow:0 6px 20px rgba(48,75,84,.08)}
    .canvas-block.is-hidden{opacity:.52;border-style:dashed}
    .upload-thumbs{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:10px}
    .upload-thumbs img{width:100%;height:88px;object-fit:cover;border:1px solid var(--line)}
    .hidden{display:none!important}
    @media(max-width:767px){.header-actions{width:100%;justify-content:flex-start}}
  </style>
  <script src="https://cdn.tailwindcss.com/3.4.17" type="text/javascript"></script>
</head>
<body class="w-full" style="background: rgb(248, 247, 243);">
  <header class="sticky-header w-full border-b border-[#dcded9]">
    <div class="max-w-7xl mx-auto px-6 md:px-10 py-3 header-top">
      <div class="header-brand">
        <a href="./index.html" aria-label="Talani Adventures home" class="shrink-0">
          <img class="w-12 h-12 md:w-14 md:h-14 object-contain" loading="lazy" src="../IMG-20261110-WA0045.jpg" alt="Talani Adventures logo">
        </a>
        <div class="min-w-0">
          <p class="display font-medium leading-tight text-[#304b54] text-lg md:text-xl">Talani Studio</p>
          <p class="text-[11px] tracking-wide text-[#968d80] font-semibold">Visual Builder • Cloudinary Folders • Trips &amp; Leads</p>
        </div>
      </div>
      <div class="header-actions">
        <a href="./index.html" class="border border-[#dcded9] bg-white px-3 py-1.5 text-xs font-semibold hover:bg-[#e9eeec] text-[#304b54]">Customer Site ↗</a>
        <a href="./group-ya-ile-kitu.html" class="border border-[#dcded9] bg-white px-3 py-1.5 text-xs font-semibold hover:bg-[#e9eeec] text-[#304b54]">Group ya Ile Kitu ↗</a>
      </div>
    </div>
    <div class="border-t border-[#e6e8e3] bg-[#f8f7f3]">
      <div class="max-w-7xl mx-auto px-6 md:px-10 subnav-strip">
        <a class="subnav-link" href="./index.html">Overview</a>
        <a class="subnav-link" href="./group-ya-ile-kitu.html">Group ya Ile Kitu</a>
        <a class="subnav-link" href="./outdoor-adventures.html">Outdoor Adventures</a>
        <a class="subnav-link" href="./talani-adventures.html">Hikes &amp; Trails</a>
        <a class="subnav-link" href="./adamanti.html">Adamanti (Coming Soon)</a>
        <a class="subnav-link" href="./talani-premium.html">Talani Premium</a>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-6 md:px-10 py-10 md:py-14">
    <div class="mb-6">
      <p class="eyebrow text-xs font-bold mb-2 text-[#968d80]">Talani Studio · Design &amp; Operations</p>
      <h1 class="display text-3xl md:text-4xl text-[#304b54]">Builder, Cloudinary Folder Uploader &amp; Operations</h1>
    </div>

    <div id="studio-tabs" class="tab-row" role="tablist" aria-label="Studio sections">
      <button type="button" class="studio-tab" role="tab" data-panel="builder-panel" aria-selected="true">1. Visual Layout &amp; Button Designer</button>
      <button type="button" class="studio-tab" role="tab" data-panel="cloudinary-panel" aria-selected="false">2. Cloudinary Destination Folders</button>
      <button type="button" class="studio-tab" role="tab" data-panel="trips-panel" aria-selected="false">3. Trips, Stories &amp; Reels</button>
      <button type="button" class="studio-tab" role="tab" data-panel="leads-panel" aria-selected="false">4. Group Inquiries</button>
    </div>

    <!-- PANEL 1: MICROSOFT ACCESS-STYLE VISUAL LAYOUT & ACTION DESIGNER -->
    <section id="builder-panel" class="space-y-6">
      <div class="bg-white border border-[#dcded9] p-5 md:p-6 flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-3">
          <label for="layout-page-select" class="text-xs font-bold uppercase tracking-wider text-[#304b54]">Page:</label>
          <select id="layout-page-select" class="border border-[#dcded9] bg-[#f8f7f3] px-3.5 py-2 text-sm font-semibold text-[#304b54]">
            <option value="index">Main Landing (index.html)</option>
            <option value="group-ya-ile-kitu">Group ya Ile Kitu (group-ya-ile-kitu.html)</option>
            <option value="talani-adventures">Hikes &amp; Trails (talani-adventures.html)</option>
            <option value="outdoor-adventures">Outdoor Adventures (outdoor-adventures.html)</option>
            <option value="talani-premium">Talani Premium (talani-premium.html)</option>
            <option value="adamanti">Adamanti (adamanti.html)</option>
          </select>
        </div>
        <div class="flex flex-wrap items-center gap-2.5">
          <button id="save-draft-btn" type="button" class="border border-[#304b54] bg-white text-[#304b54] px-4 py-2.5 text-xs font-bold uppercase tracking-wider cursor-pointer hover:bg-[#e9eeec]">Save Draft</button>
          <button id="publish-layout-btn" type="button" class="bg-[#304b54] text-white px-5 py-2.5 text-xs font-bold uppercase tracking-wider cursor-pointer hover:opacity-85">Publish to Live Site ↗</button>
        </div>
      </div>
      <p id="builder-status" class="text-xs font-bold text-[#315d4d] min-h-[1.25rem]"></p>

      <div class="grid lg:grid-cols-[1.2fr_.8fr] gap-6 items-start">
        <!-- DESIGN CANVAS (MOVE & RESIZE BLOCKS) -->
        <div class="space-y-3">
          <p class="eyebrow text-xs font-bold text-[#968d80]">Design Canvas (Select a block to move, resize, or add buttons)</p>
          <div id="design-canvas" class="space-y-3"></div>
        </div>

        <!-- INSPECTOR & ACTION BUILDER -->
        <aside class="bg-white border border-[#dcded9] p-6 space-y-5 lg:sticky lg:top-32">
          <div>
            <p class="eyebrow text-[10px] font-bold text-[#968d80]">Property &amp; Action Inspector</p>
            <h2 id="inspector-block-name" class="display text-xl text-[#304b54] mt-1">Select a block</h2>
          </div>

          <div>
            <label for="prop-title" class="block text-xs font-bold uppercase tracking-wider text-[#304b54] mb-1">Heading Override (Optional)</label>
            <input id="prop-title" type="text" placeholder="Leave blank to keep page default" class="w-full border border-[#dcded9] bg-[#f8f7f3] px-3 py-2 text-sm text-[#304b54]" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="prop-width" class="block text-xs font-bold uppercase tracking-wider text-[#304b54] mb-1">Width (%)</label>
              <input id="prop-width" type="number" min="40" max="100" step="5" value="100" class="w-full border border-[#dcded9] bg-[#f8f7f3] px-3 py-2 text-sm text-[#304b54]" />
            </div>
            <div>
              <label for="prop-scale" class="block text-xs font-bold uppercase tracking-wider text-[#304b54] mb-1">Size / Scale</label>
              <select id="prop-scale" class="w-full border border-[#dcded9] bg-[#f8f7f3] px-3 py-2 text-sm text-[#304b54]">
                <option value="0.9">Compact (0.9×)</option>
                <option value="1" selected>Standard (1.0×)</option>
                <option value="1.08">Large (1.08×)</option>
              </select>
            </div>
          </div>

          <label class="flex items-center gap-2 text-xs font-bold text-[#304b54] cursor-pointer">
            <input id="prop-hidden" type="checkbox" />
            Hide this block on the customer page
          </label>

          <div class="border-t border-[#dcded9] pt-4 space-y-3">
            <p class="eyebrow text-[10px] font-bold text-[#968d80]">Add Button &amp; Wire Behavior</p>
            <input id="btn-label" type="text" placeholder="Button label (e.g., Book Gatamaiyu)" class="w-full border border-[#dcded9] bg-[#f8f7f3] px-3 py-2 text-sm text-[#304b54]" />
            <select id="btn-action-type" class="w-full border border-[#dcded9] bg-[#f8f7f3] px-3 py-2 text-sm text-[#304b54]">
              <option value="link">Open Page / URL</option>
              <option value="scroll">Scroll to Section (#id)</option>
              <option value="select-destination">Open Inquiry Form With Destination</option>
            </select>
            <input id="btn-target" type="text" placeholder="Target (e.g., ./group-ya-ile-kitu.html or #inquiry-section)" class="w-full border border-[#dcded9] bg-[#f8f7f3] px-3 py-2 text-sm text-[#304b54]" />
            <select id="btn-style" class="w-full border border-[#dcded9] bg-[#f8f7f3] px-3 py-2 text-sm text-[#304b54]">
              <option value="primary">Solid Dark Button</option>
              <option value="outline">Outlined Button</option>
            </select>
            <button id="add-btn-action" type="button" class="w-full bg-[#304b54] text-white py-2.5 text-xs font-bold uppercase tracking-wider cursor-pointer hover:opacity-85">+ Attach Button to Block</button>
            <ul id="block-buttons-list" class="space-y-1.5 text-xs"></ul>
          </div>
        </aside>
      </div>
    </section>

    <!-- PANEL 2: CLOUDINARY DESTINATION FOLDER UPLOADER -->
    <section id="cloudinary-panel" class="hidden space-y-6 max-w-4xl">
      <div class="bg-white border border-[#dcded9] p-6 md:p-8 space-y-5">
        <div>
          <p class="eyebrow text-xs font-bold mb-2 text-[#968d80]">Cloudinary Media Library · Nx35scok</p>
          <h2 class="display text-2xl text-[#304b54]">Upload Destination Photos by Folder</h2>
          <p class="text-sm text-[#52636a] mt-1">Select a destination folder, choose up to 8 photos, upload to Cloudinary, and copy the generated <code>photos</code> array for <code>public/itinerary-data.js</code>.</p>
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="cld-dest-select" class="block text-xs font-bold uppercase tracking-wider text-[#304b54] mb-1.5">Destination (All 54 + Outdoor)</label>
            <select id="cld-dest-select" class="w-full border border-[#dcded9] bg-[#f8f7f3] px-3.5 py-3 text-sm text-[#304b54]"></select>
          </div>
          <div>
            <label for="cld-folder-path" class="block text-xs font-bold uppercase tracking-wider text-[#304b54] mb-1.5">Cloudinary Folder Path</label>
            <input id="cld-folder-path" type="text" class="w-full border border-[#dcded9] bg-[#f8f7f3] px-3.5 py-3 text-sm font-mono text-[#304b54]" />
          </div>
        </div>

        <div>
          <label for="cld-files" class="block text-xs font-bold uppercase tracking-wider text-[#304b54] mb-1.5">Choose Photos (up to 8)</label>
          <input id="cld-files" type="file" accept="image/*" multiple class="w-full border border-[#dcded9] bg-[#f8f7f3] p-3 text-sm text-[#304b54]" />
        </div>

        <div class="flex flex-wrap gap-3">
          <button id="cld-upload-btn" type="button" class="bg-[#304b54] text-white px-6 py-3 text-xs font-bold uppercase tracking-wider cursor-pointer hover:opacity-85">Upload to Cloudinary ↗</button>
          <button id="cld-copy-json" type="button" class="border border-[#304b54] text-[#304b54] px-5 py-3 text-xs font-bold uppercase tracking-wider cursor-pointer hover:bg-[#e9eeec]">Copy JSON Array</button>
        </div>
        <p id="cld-status" class="text-xs font-semibold text-[#315d4d]"></p>

        <div id="cld-thumbs" class="upload-thumbs"></div>
        <textarea id="cld-json-output" rows="7" readonly placeholder="Uploaded photo JSON entries will appear here..." class="w-full border border-[#dcded9] bg-[#f8f7f3] p-3 text-xs font-mono text-[#304b54]"></textarea>
      </div>
    </section>

    <!-- PANEL 3: TRIPS, STORIES & REELS -->
    <section id="trips-panel" class="hidden space-y-8 max-w-4xl">
      <div class="bg-white border border-[#dcded9] p-6 md:p-8">
        <h2 class="display text-2xl text-[#304b54] mb-4">Publish Active Trip / Hike / Expedition</h2>
        <form id="trip-form" class="space-y-4">
          <div class="grid sm:grid-cols-2 gap-4">
            <select id="t-brand" class="border border-[#dcded9] bg-[#f8f7f3] px-3.5 py-3 text-sm text-[#304b54]">
              <option value="Group ya Ile Kitu">Group ya Ile Kitu</option>
              <option value="Talani Adventures">Talani Adventures (Hikes &amp; Trails)</option>
              <option value="Outdoor Adventures">Outdoor Adventures (Safaris &amp; Wildlife)</option>
              <option value="Talani Premium Tours">Talani Premium Tours</option>
            </select>
            <input id="t-title" type="text" required placeholder="Title (e.g., Gatamaiyu Forest Reserve Hike)" class="border border-[#dcded9] bg-[#f8f7f3] px-3.5 py-3 text-sm text-[#304b54]" />
          </div>
          <div class="grid sm:grid-cols-4 gap-3">
            <input id="t-date" type="date" required class="border border-[#dcded9] bg-[#f8f7f3] px-3 py-2.5 text-sm text-[#304b54]" />
            <input id="t-price" type="number" required placeholder="Price KSh" class="border border-[#dcded9] bg-[#f8f7f3] px-3 py-2.5 text-sm text-[#304b54]" />
            <input id="t-deposit" type="number" required placeholder="Deposit KSh" class="border border-[#dcded9] bg-[#f8f7f3] px-3 py-2.5 text-sm text-[#304b54]" />
            <input id="t-slots-left" type="number" required placeholder="Slots left" class="border border-[#dcded9] bg-[#f8f7f3] px-3 py-2.5 text-sm text-[#304b54]" />
          </div>
          <input id="t-cover" type="url" required placeholder="Cover image URL (https://...)" class="w-full border border-[#dcded9] bg-[#f8f7f3] px-3.5 py-3 text-sm text-[#304b54]" />
          <textarea id="t-bio" rows="3" placeholder="Trip highlights & inclusions..." class="w-full border border-[#dcded9] bg-[#f8f7f3] px-3.5 py-3 text-sm text-[#304b54]"></textarea>
          <input id="t-discount" type="text" placeholder="Group discount note (e.g., 5% off 3–5 pax • 7% off 5–7 pax • 10% off 7–10 pax)" class="w-full border border-[#dcded9] bg-[#f8f7f3] px-3.5 py-3 text-sm text-[#304b54]" />
          <button type="submit" class="bg-[#304b54] text-white px-6 py-3 text-xs font-bold uppercase tracking-wider cursor-pointer">Publish Trip to Firestore ↗</button>
          <p id="trip-status" class="text-xs font-semibold text-[#315d4d]"></p>
        </form>
      </div>
    </section>

    <!-- PANEL 4: GROUP INQUIRIES -->
    <section id="leads-panel" class="hidden space-y-4 max-w-4xl">
      <div class="bg-white border border-[#dcded9] p-6 md:p-8">
        <h2 class="display text-2xl text-[#304b54] mb-4">Incoming Group &amp; Destination Inquiries</h2>
        <div id="leads-list" class="space-y-3 text-sm text-[#52636a]">Loading leads...</div>
      </div>
    </section>
  </main>

  <script type="module">
  import { ITINERARY_DATA } from "./itinerary-data.js";
  import { TALANI_FIREBASE_CONFIG } from "./layout-runtime.js";
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
  import { getFirestore, collection, doc, setDoc, getDoc, addDoc, query, orderBy, onSnapshot, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

  const CLOUD_NAME = "Nx35scok";
  const UPLOAD_PRESET = "talani_unsigned";

  const PAGE_BLOCKS = {
    "index": [
      { id: "hero", label: "Hero — Who We Are" },
      { id: "stories", label: "Field Dispatches / Stories" },
      { id: "active-spotlight", label: "Active Tours, Hikes & Expeditions" },
      { id: "services", label: "Our Divisions & Pages" },
      { id: "memories", label: "D-Day Memories & Reels" },
      { id: "about", label: "Company Ethos Banner" }
    ],
    "group-ya-ile-kitu": [
      { id: "group-hero", label: "Group ya Ile Kitu Header & Tiers" },
      { id: "catalog-section", label: "All Destinations Catalog" },
      { id: "inquiry-section", label: "Group Inquiry Form" }
    ],
    "talani-adventures": [
      { id: "trails-hero", label: "Hikes & Trails Hero" },
      { id: "scheduled-trails", label: "Scheduled Hikes & Trails" },
      { id: "trails-directory", label: "Trails & Hikes Directory" }
    ],
    "outdoor-adventures": [
      { id: "safari-hero", label: "Safaris & Wildlife Hero" },
      { id: "safari-cards", label: "Safari & Wildlife Offerings" }
    ],
    "talani-premium": [
      { id: "premium-hero", label: "Talani Premium Hero" },
      { id: "premium-grid-section", label: "Multi-Day Expeditions & Retreats" }
    ],
    "adamanti": [
      { id: "adamanti-coming-soon", label: "Adamanti Coming Soon Section" }
    ]
  };

  let db = null;
  try { db = getFirestore(initializeApp(TALANI_FIREBASE_CONFIG)); } catch {}

  const $ = (id) => document.getElementById(id);

  // Tabs switching
  $("studio-tabs").addEventListener("click", (e) => {
    const tab = e.target.closest("button[role=tab]");
    if (!tab) return;
    $("studio-tabs").querySelectorAll("button[role=tab]").forEach((t) => t.setAttribute("aria-selected", String(t === tab)));
    ["builder-panel", "cloudinary-panel", "trips-panel", "leads-panel"].forEach((pid) => {
      $(pid).classList.toggle("hidden", pid !== tab.dataset.panel);
    });
  });

  // --- 1. VISUAL LAYOUT & ACTION DESIGNER ---
  let currentPageKey = "index";
  let currentBlocks = [];
  let selectedBlockId = null;

  function defaultBlocksFor(pageKey) {
    return (PAGE_BLOCKS[pageKey] || []).map((b, idx) => ({
      id: b.id,
      label: b.label,
      order: idx,
      widthPct: 100,
      scale: 1,
      hidden: false,
      customTitle: "",
      buttons: []
    }));
  }

  async function loadPageLayout(pageKey) {
    currentPageKey = pageKey;
    $("builder-status").textContent = "Loading layout...";
    let blocks = defaultBlocksFor(pageKey);

    if (db) {
      try {
        const snap = await getDoc(doc(db, "site_layouts", pageKey));
        if (snap.exists() && Array.isArray(snap.data().blocks) && snap.data().blocks.length) {
          const savedMap = new Map(snap.data().blocks.map((b) => [b.id, b]));
          blocks = blocks.map((def, idx) => ({ ...def, ...(savedMap.get(def.id) || {}), order: savedMap.get(def.id)?.order ?? idx }));
          blocks.sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
        }
      } catch {}
    }

    currentBlocks = blocks;
    selectedBlockId = currentBlocks[0]?.id || null;
    renderCanvas();
    syncInspector();
    $("builder-status").textContent = `Editing "${pageKey}" layout.`;
  }

  function renderCanvas() {
    currentBlocks.forEach((b, i) => { b.order = i; });
    $("design-canvas").innerHTML = currentBlocks.map((b, idx) => `
      <div class="canvas-block ${b.id === selectedBlockId ? "selected" : ""} ${b.hidden ? "is-hidden" : ""}" data-select-block="${b.id}" style="width:${b.widthPct || 100}%;margin:0 auto;transform:scale(${b.scale || 1});transform-origin:top center;">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <p class="text-xs font-extrabold text-[#304b54]">${idx + 1}. ${b.customTitle || b.label}</p>
            <p class="text-[11px] text-[#61767b]">Width: ${b.widthPct || 100}% • Scale: ${b.scale || 1}× • Buttons: ${(b.buttons || []).length}${b.hidden ? " • HIDDEN" : ""}</p>
          </div>
          <div class="flex items-center gap-1.5">
            <button type="button" data-move="up" data-id="${b.id}" class="move-btn border border-[#dcded9] px-2.5 py-1 text-xs font-bold cursor-pointer hover:bg-[#e9eeec]">↑</button>
            <button type="button" data-move="down" data-id="${b.id}" class="move-btn border border-[#dcded9] px-2.5 py-1 text-xs font-bold cursor-pointer hover:bg-[#e9eeec]">↓</button>
          </div>
        </div>
      </div>
    `).join("");

    document.querySelectorAll("[data-select-block]").forEach((card) => {
      card.addEventListener("click", (e) => {
        if (e.target.closest(".move-btn")) return;
        selectedBlockId = card.dataset.selectBlock;
        renderCanvas();
        syncInspector();
      });
    });

    document.querySelectorAll(".move-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const idx = currentBlocks.findIndex((x) => x.id === btn.dataset.id);
        if (idx < 0) return;
        const swapWith = btn.dataset.move === "up" ? idx - 1 : idx + 1;
        if (swapWith < 0 || swapWith >= currentBlocks.length) return;
        [currentBlocks[idx], currentBlocks[swapWith]] = [currentBlocks[swapWith], currentBlocks[idx]];
        selectedBlockId = currentBlocks[swapWith].id;
        renderCanvas();
        syncInspector();
      });
    });
  }

  function syncInspector() {
    const block = currentBlocks.find((b) => b.id === selectedBlockId);
    if (!block) return;
    $("inspector-block-name").textContent = block.label;
    $("prop-title").value = block.customTitle || "";
    $("prop-width").value = block.widthPct || 100;
    $("prop-scale").value = String(block.scale || 1);
    $("prop-hidden").checked = Boolean(block.hidden);
    renderBlockButtons(block);
  }

  function renderBlockButtons(block) {
    const list = block.buttons || [];
    $("block-buttons-list").innerHTML = list.map((btn, i) => `
      <li class="flex items-center justify-between gap-2 bg-[#f8f7f3] border border-[#dcded9] px-2.5 py-1.5">
        <span><strong>${btn.label}</strong> (${btn.actionType}: ${btn.target})</span>
        <button type="button" data-del-btn="${i}" class="del-btn text-red-700 font-bold cursor-pointer">✕</button>
      </li>
    `).join("") || `<li class="text-[#61767b]">No custom buttons attached to this block yet.</li>`;

    document.querySelectorAll(".del-btn").forEach((del) => {
      del.addEventListener("click", () => {
        block.buttons.splice(Number(del.dataset.delBtn), 1);
        renderBlockButtons(block);
        renderCanvas();
      });
    });
  }

  ["prop-title", "prop-width", "prop-scale", "prop-hidden"].forEach((id) => {
    $(id).addEventListener("input", () => {
      const block = currentBlocks.find((b) => b.id === selectedBlockId);
      if (!block) return;
      block.customTitle = $("prop-title").value.trim();
      block.widthPct = Math.min(100, Math.max(40, Number($("prop-width").value) || 100));
      block.scale = Number($("prop-scale").value) || 1;
      block.hidden = $("prop-hidden").checked;
      renderCanvas();
    });
  });

  $("add-btn-action").addEventListener("click", () => {
    const block = currentBlocks.find((b) => b.id === selectedBlockId);
    const label = $("btn-label").value.trim();
    const target = $("btn-target").value.trim();
    if (!block || !label || !target) return;
    block.buttons = block.buttons || [];
    block.buttons.push({
      label,
      actionType: $("btn-action-type").value,
      target,
      style: $("btn-style").value
    });
    $("btn-label").value = "";
    $("btn-target").value = "";
    renderBlockButtons(block);
    renderCanvas();
  });

  $("layout-page-select").addEventListener("change", () => loadPageLayout($("layout-page-select").value));

  $("save-draft-btn").addEventListener("click", () => {
    localStorage.setItem(`talani_draft_${currentPageKey}`, JSON.stringify(currentBlocks));
    $("builder-status").textContent = `Draft saved locally for "${currentPageKey}".`;
  });

  $("publish-layout-btn").addEventListener("click", async () => {
    if (!db) {
      $("builder-status").textContent = "Connect Firestore to publish live layouts to the customer site.";
      return;
    }
    $("builder-status").textContent = "Publishing layout...";
    try {
      await setDoc(doc(db, "site_layouts", currentPageKey), {
        pageKey: currentPageKey,
        blocks: currentBlocks,
        updatedAt: serverTimestamp()
      });
      $("builder-status").textContent = `✓ Published "${currentPageKey}" layout live!`;
    } catch (err) {
      $("builder-status").textContent = "Publish failed: " + err.message;
    }
  });

  loadPageLayout("index");

  // --- 2. CLOUDINARY DESTINATION FOLDER UPLOADER ---
  function folderForDestination(item) {
    const sub = item.category === "Trails" ? "trails" : item.category === "Hikes" ? "hikes" : "multi-day";
    return `talani/${sub}/${item.id}`;
  }

  $("cld-dest-select").innerHTML = [
    ...ITINERARY_DATA.map((d) => `<option value="${d.id}" data-folder="${folderForDestination(d)}">${d.title} (${d.category})</option>`),
    `<option value="outdoor-adventures" data-folder="talani/outdoor-adventures">Outdoor Adventures (Safaris & Wildlife)</option>`
  ].join("");

  function syncFolderInput() {
    const opt = $("cld-dest-select").selectedOptions[0];
    $("cld-folder-path").value = opt?.dataset.folder || "talani/general";
  }
  $("cld-dest-select").addEventListener("change", syncFolderInput);
  syncFolderInput();

  let uploadedPhotos = [];

  $("cld-upload-btn").addEventListener("click", async () => {
    const files = Array.from($("cld-files").files || []).slice(0, 8);
    if (!files.length) {
      $("cld-status").textContent = "Choose at least one photo first.";
      return;
    }
    const folder = $("cld-folder-path").value.trim() || "talani/general";
    $("cld-status").textContent = `Uploading ${files.length} photo(s) to ${folder}...`;
    uploadedPhotos = [];
    $("cld-thumbs").innerHTML = "";

    for (const file of files) {
      const fd = new FormData();
      fd.append("file", file);
      fd.append("upload_preset", UPLOAD_PRESET);
      fd.append("folder", folder);

      const res = await fetch(`https://api.cloudinary.com/v1_1/${CLOUD_NAME}/image/upload`, {
        method: "POST",
        body: fd
      });
      if (!res.ok) throw new Error(`Cloudinary upload failed (${res.status})`);
      const data = await res.json();
      uploadedPhotos.push({
        url: data.secure_url,
        caption: file.name.replace(/\.[^.]+$/, "").replace(/[-_]+/g, " ")
      });
      $("cld-thumbs").innerHTML += `<img src="${data.secure_url}" alt="${file.name}" loading="lazy" />`;
    }

    $("cld-json-output").value = JSON.stringify(uploadedPhotos, null, 2);
    $("cld-status").textContent = `✓ Uploaded ${uploadedPhotos.length} photo(s) to "${folder}".`;
  });

  $("cld-copy-json").addEventListener("click", async () => {
    if (!$("cld-json-output").value) return;
    await navigator.clipboard?.writeText($("cld-json-output").value);
    $("cld-status").textContent = "✓ Copied JSON array to clipboard.";
  });

  // --- 3. TRIPS FORM & 4. LEADS ---
  $("trip-form").addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!db) { $("trip-status").textContent = "Firestore unavailable."; return; }
    try {
      await addDoc(collection(db, "trips"), {
        brand: $("t-brand").value,
        title: $("t-title").value.trim(),
        date: $("t-date").value,
        price: Number($("t-price").value) || 0,
        deposit: Number($("t-deposit").value) || 0,
        slotsLeft: Number($("t-slots-left").value) || 0,
        coverUrl: $("t-cover").value.trim(),
        bio: $("t-bio").value.trim(),
        groupDiscountNote: $("t-discount").value.trim(),
        createdAt: serverTimestamp()
      });
      $("trip-form").reset();
      $("trip-status").textContent = "✓ Trip published to Firestore.";
    } catch (err) {
      $("trip-status").textContent = "Error: " + err.message;
    }
  });

  if (db) {
    onSnapshot(query(collection(db, "leads"), orderBy("createdAt", "desc")), (snap) => {
      if (snap.empty) {
        $("leads-list").innerHTML = "<p>No inquiries yet.</p>";
        return;
      }
      $("leads-list").innerHTML = snap.docs.map((d) => {
        const x = d.data();
        return `<div class="border border-[#dcded9] bg-[#f8f7f3] p-4">
          <p class="font-bold text-[#304b54]">${x.name || "Guest"} • ${x.phone || ""}</p>
          <p class="text-xs font-semibold text-[#61767b] mt-0.5">${x.tripName || ""} (${x.pax || 1} pax)</p>
          <p class="text-xs mt-2">${x.aiSummary || ""}</p>
        </div>`;
      }).join("");
    });
  }
  </script>
</body>
</html>
